{
  "redirects": [
    {
      "source": "/biblioteca",
      "destination": "/?c=bib",
      "permanent": false
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "locusmundi.vercel.app"
        }
      ],
      "destination": "https://www.locusmundi.com/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/libro/:id",
      "destination": "/api/contador-historias?pagina=libro&id=:id"
    },
    {
      "source": "/en",
      "destination": "/api/contador-historias?pagina=en"
    },
    {
      "source": "/ca",
      "destination": "/api/contador-historias?pagina=ca"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/contador-historias?pagina=sitemap"
    },
    {
      "source": "/archivo",
      "destination": "/api/contador-historias?pagina=archivo"
    },
    {
      "source": "/archivo/:id",
      "destination": "/api/contador-historias?pagina=archivo&id=:id"
    },
    {
      "source": "/arbol",
      "destination": "/arbol.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/diario",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/backup-semanal",
      "schedule": "0 4 * * 0"
    }
  ],
  "functions": {
    "api/pdf.js": {
      "maxDuration": 300,
      "includeFiles": "{lectura.js,logo_locus_mundi_fondo_blanco.png,node_modules/{@sparticuz/chromium/bin,@fontsource/eb-garamond/files,@fontsource/playfair-display/files}/**}"
    },
    "api/backup-semanal.js": {
      "maxDuration": 300
    },
    "api/contador-historias.js": {
      "includeFiles": "{index.html,lectura.js}"
    }
  }
}
