{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/diario",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/backup-semanal",
      "schedule": "0 4 * * 0"
    }
  ],
  "functions": {
    "api/pdf-prueba.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/{@sparticuz/chromium/bin/**,pagedjs/dist/paged.polyfill.min.js,@fontsource/eb-garamond/files/*-{latin,latin-ext,cyrillic}-400-*.woff2,@fontsource/playfair-display/files/*-{latin,latin-ext,cyrillic}-400-normal.woff2}"
    }
  }
}
