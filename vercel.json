{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/diario",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/backup-semanal",
      "schedule": "0 4 * * 0"
    }
  ],
  "functions": {
    "api/pdf.js": {
      "maxDuration": 300,
      "includeFiles": "{lectura.js,logo_locus_mundi_fondo_blanco.png,node_modules/{@sparticuz/chromium/bin,@fontsource/eb-garamond/files,@fontsource/playfair-display/files}/**}"
    }
  }
}
